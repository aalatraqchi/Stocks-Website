# Copy this file to .env and fill in your own values. Never commit .env.

# Free API key from https://finnhub.io/register
# Leave blank to run in demo mode with simulated prices.
FINNHUB_API_KEY=

# Random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: where to store the SQLite database (defaults to finance.db in the project folder).
# DATABASE_PATH=finance.db
